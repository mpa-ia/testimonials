{
  "name": "new-wave-festival",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "SET NODE_ENV = 'production' && nodemon server.js",
    "start:dev": "SET NODE_ENV = 'dev' && nodemon server.js",
    "build": "cd client && yarn install && yarn build",
    "test": "SET NODE_ENV = 'dev' && mocha \"./tests/**/*.test.js\"",
    "test:watch": "SET NODE_ENV = 'dev' && onchange \"./**/*.js\" -i -k -- yarn run test"
  },
  "dependencies": {
    "chai": "4.5.0",
    "chai-http": "4.4.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mocha": "6.2.3",
    "helmet": "^3.23.3",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^5.13.22",
    "onchange": "6.1.1",
    "socket.io": "^2.5.1",
    "uuid": "^7.0.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.2"
  }
}